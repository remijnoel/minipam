# MiniPAM Configuration - API Key Authentication Example

server:
  host: "0.0.0.0"
  port: 8000
  debug: false

storage:
  type: "file"
  path: "./data"

auth:
  backend: "apikey"
  apikey:
    keys:
      - "minipam-api-key-development-only"
      - "another-api-key-for-testing"
  # Note: In production, use environment variables instead:
  # MINIPAM_AUTH_APIKEY_KEYS=key1,key2,key3

ui:
  enabled: true
  path: "/ui"

# Usage:
# curl -H "Authorization: Bearer minipam-api-key-development-only" \
#      http://localhost:8000/api/v1/cidrs
#
# or
#
# curl -H "X-API-Key: minipam-api-key-development-only" \
#      http://localhost:8000/api/v1/cidrs