# MiniPAM Configuration File
# This is an example configuration file for MiniPAM
# Copy this to config.yaml and modify as needed

# Server configuration
server:
  host: "0.0.0.0"
  port: 8000
  log_level: "info"  # debug, info, warning, error, critical

# Storage configuration
storage:
  type: "file"  # "memory" or "file"
  
  # File storage configuration (only used when type is "file")
  file:
    path: "cidrs.json"  # Path to the data file
    
  # Future storage backends can be added here
  # database:
  #   type: "postgresql"
  #   host: "localhost"
  #   port: 5432
  #   database: "minipam"
  #   username: "user"
  #   password: "pass"

# Debug mode
debug: false

# CORS configuration
cors:
  enabled: true
  origins:
    - "*"
  # For production, specify allowed origins:
  # origins:
  #   - "https://yourdomain.com"
  #   - "https://app.yourdomain.com"

# Web UI configuration
ui:
  enabled: true
  path: "webui/dist"
