# MiniPAM Configuration Example
# Copy this file to config.yaml and customize for your environment

# Server configuration
server:
  host: "0.0.0.0"        # Bind address (0.0.0.0 for all interfaces)
  port: 8000             # HTTP port
  debug: false           # Enable debug mode (development only)

# Storage backend configuration
storage:
  type: "file"           # Storage type: "file" or "memory"
  path: "./data"         # Storage path (for file backend)

# Authentication configuration
auth:
  backend: "none"        # Auth backend: "none", "apikey", or "oidc"
  
  # API Key authentication (when backend: "apikey")
  apikey:
    keys: []             # List of valid API keys
    # Example:
    # keys:
    #   - "your-secret-api-key-1"
    #   - "your-secret-api-key-2"
  
  # OIDC authentication (when backend: "oidc")
  oidc:
    issuer_url: ""       # OIDC issuer URL (e.g., https://auth.example.com)
    client_id: ""        # OIDC client ID
    client_secret: ""    # OIDC client secret (use env var MINIPAM_AUTH_OIDC_CLIENT_SECRET)
    jwks_cache_ttl: 600  # JWKS cache TTL in seconds

# UI configuration
ui:
  enabled: true          # Enable embedded web UI
  path: "/ui"            # UI path

# Example environment variable overrides:
# MINIPAM_SERVER_HOST=127.0.0.1
# MINIPAM_SERVER_PORT=9000
# MINIPAM_SERVER_DEBUG=true
# MINIPAM_STORAGE_TYPE=memory
# MINIPAM_AUTH_BACKEND=apikey
# MINIPAM_AUTH_APIKEY_KEYS=key1,key2,key3
# MINIPAM_AUTH_OIDC_ISSUER_URL=https://auth.example.com
# MINIPAM_AUTH_OIDC_CLIENT_ID=minipam-client
# MINIPAM_AUTH_OIDC_CLIENT_SECRET=your-secret
# MINIPAM_UI_ENABLED=false