# MiniPAM Environment Configuration Example
# Copy this file to .env and customize for your deployment

# =============================================================================
# BASIC SERVER CONFIGURATION
# =============================================================================

# Storage configuration
MINIPAM_STORAGE_TYPE=file
MINIPAM_STORAGE_FILE_PATH=/app/data/cidrs.json

# Server configuration
MINIPAM_SERVER_HOST=0.0.0.0
MINIPAM_SERVER_PORT=8000
MINIPAM_SERVER_LOG_LEVEL=info

# Debug mode (set to true for development)
# MINIPAM_DEBUG=true

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Authentication backend: none, apikey, or oidc
MINIPAM_AUTH_BACKEND=apikey

# JWT token configuration
MINIPAM_JWT_SECRET=your-super-secret-jwt-key-change-in-production
MINIPAM_JWT_ALGORITHM=HS256
MINIPAM_JWT_ISSUER=minipam
MINIPAM_JWT_EXPIRY_HOURS=8

# =============================================================================
# API KEY AUTHENTICATION
# =============================================================================
# Format: MINIPAM_API_KEY_<USERNAME>=<api-key>:<role>
# Roles: readonly, readwrite

# Administrative access
MINIPAM_API_KEY_ADMIN=sk-minipam-admin-12345:readwrite

# Read-only access for monitoring/viewing
MINIPAM_API_KEY_VIEWER=sk-minipam-viewer-67890:readonly

# Service-to-service access
MINIPAM_API_KEY_SERVICE=sk-minipam-service-99999:readwrite

# Additional users (uncomment and customize as needed)
# MINIPAM_API_KEY_ALICE=sk-alice-11111:readwrite
# MINIPAM_API_KEY_BOB=sk-bob-22222:readonly

# =============================================================================
# OIDC AUTHENTICATION (Enterprise SSO)
# =============================================================================
# Uncomment and configure these for OIDC authentication
# Set MINIPAM_AUTH_BACKEND=oidc to enable

# OIDC provider configuration
# MINIPAM_OIDC_CLIENT_ID=your-oidc-client-id
# MINIPAM_OIDC_CLIENT_SECRET=your-oidc-client-secret
# MINIPAM_OIDC_ISSUER_URL=https://your-provider.com
# MINIPAM_OIDC_REDIRECT_URI=http://localhost:8000/auth/callback/oidc
# MINIPAM_OIDC_SCOPE=openid profile email

# Role mapping: map OIDC groups to MiniPAM roles
# MINIPAM_OIDC_ROLE_CLAIM=groups
# MINIPAM_OIDC_ROLE_MAPPING=minipam-admins:readwrite,minipam-viewers:readonly
# MINIPAM_OIDC_DEFAULT_ROLE=readonly

# -----------------------------------------------------------------------------
# Azure Entra ID (Microsoft 365) Example Configuration
# -----------------------------------------------------------------------------
# For Azure Entra ID (formerly Azure AD), use these settings:
#
# MINIPAM_AUTH_BACKEND=oidc
# MINIPAM_OIDC_CLIENT_ID=12345678-1234-1234-1234-123456789abc
# MINIPAM_OIDC_CLIENT_SECRET=your~azure~client~secret~here
# MINIPAM_OIDC_ISSUER_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0
# MINIPAM_OIDC_REDIRECT_URI=http://localhost:8000/auth/callback/oidc
# MINIPAM_OIDC_SCOPE=openid profile email
# MINIPAM_OIDC_ROLE_CLAIM=groups
# MINIPAM_OIDC_ROLE_MAPPING=minipam-admins:readwrite,minipam-users:readonly
# MINIPAM_OIDC_DEFAULT_ROLE=readonly
#
# Setup Steps for Azure Entra ID:
# 1. Azure Portal → Azure Active Directory → App registrations → New registration
# 2. Name: MiniPAM, Redirect URI: http://localhost:8000/auth/callback/oidc
# 3. Copy Application (client) ID and Directory (tenant) ID
# 4. Certificates & secrets → New client secret → Copy secret value
# 5. Create Azure AD groups: minipam-admins, minipam-users
# 6. Assign users to groups based on required access level

# -----------------------------------------------------------------------------
# Google Workspace Example Configuration
# -----------------------------------------------------------------------------
# For Google Workspace, use these settings:
#
# MINIPAM_AUTH_BACKEND=oidc
# MINIPAM_OIDC_CLIENT_ID=your-google-client-id.googleusercontent.com
# MINIPAM_OIDC_CLIENT_SECRET=your-google-client-secret
# MINIPAM_OIDC_ISSUER_URL=https://accounts.google.com
# MINIPAM_OIDC_REDIRECT_URI=http://localhost:8000/auth/callback/oidc
# MINIPAM_OIDC_SCOPE=openid profile email
# MINIPAM_OIDC_ROLE_CLAIM=groups
# MINIPAM_OIDC_ROLE_MAPPING=minipam-admins@company.com:readwrite,minipam-users@company.com:readonly
# MINIPAM_OIDC_DEFAULT_ROLE=readonly

# -----------------------------------------------------------------------------
# Okta Example Configuration
# -----------------------------------------------------------------------------
# For Okta, use these settings:
#
# MINIPAM_AUTH_BACKEND=oidc
# MINIPAM_OIDC_CLIENT_ID=your-okta-client-id
# MINIPAM_OIDC_CLIENT_SECRET=your-okta-client-secret
# MINIPAM_OIDC_ISSUER_URL=https://your-domain.okta.com/oauth2/default
# MINIPAM_OIDC_REDIRECT_URI=http://localhost:8000/auth/callback/oidc
# MINIPAM_OIDC_SCOPE=openid profile email groups
# MINIPAM_OIDC_ROLE_CLAIM=groups
# MINIPAM_OIDC_ROLE_MAPPING=MiniPAM Admins:readwrite,MiniPAM Users:readonly
# MINIPAM_OIDC_DEFAULT_ROLE=readonly

# =============================================================================
# DEVELOPMENT MODE (No Authentication)
# =============================================================================
# Uncomment these for development with no authentication
# Set MINIPAM_AUTH_BACKEND=none to enable

# MINIPAM_AUTH_BACKEND=none
# MINIPAM_DEFAULT_USERNAME=dev-user
# MINIPAM_DEFAULT_ROLE=readwrite

# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# 1. JWT Secret:
#    - Generate with: openssl rand -base64 32
#    - Must be kept secret and consistent across restarts
#
# 2. API Keys:
#    - Generate with: openssl rand -base64 32 | tr -d "=+/" | cut -c1-32
#    - Use descriptive prefixes (sk-minipam-user-xxxxx)
#    - Store securely and rotate regularly
#
# 3. Production Deployment:
#    - Use Docker secrets or your platform's secret management
#    - Never commit .env files with real secrets to version control
#    - Use HTTPS in production (configure reverse proxy)
#    - Monitor authentication logs for suspicious activity
#
# =============================================================================
