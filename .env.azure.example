# Example Azure OIDC environment file for MiniPAM
# Copy this file to .env.azure and update with your Azure AD values

# Server Configuration
MINIPAM_PORT=8000
MINIPAM_DEBUG=false

# Storage Configuration
MINIPAM_STORAGE_TYPE=file

# Authentication Configuration - Azure OIDC
MINIPAM_AUTH_BACKEND=oidc
ENABLE_NOAUTH=false

# Azure AD Configuration
MINIPAM_AUTH_OIDC_ISSUER_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
MINIPAM_AUTH_OIDC_CLIENT_ID=your-azure-ad-application-id
MINIPAM_AUTH_OIDC_CLIENT_SECRET=your-azure-ad-client-secret
MINIPAM_AUTH_OIDC_JWKS_CACHE_TTL=300

# UI Configuration
MINIPAM_UI_ENABLED=true
MINIPAM_UI_PATH=/