# MiniPAM Environment Configuration - Azure Entra ID Authentication
# Copy this file to .env to use Azure Entra ID (OIDC) authentication

# Configuration file to use
MINIPAM_CONFIG_FILE=/app/config.azure.yaml

# Production JWT secret (change this!)
MINIPAM_JWT_SECRET=your-production-jwt-secret-change-this

# Azure Entra ID Application Details
# Get these values from your Azure Portal app registration
MINIPAM_OIDC_CLIENT_ID=12345678-1234-1234-1234-123456789abc
MINIPAM_OIDC_CLIENT_SECRET=your~azure~client~secret~here
MINIPAM_OIDC_ISSUER_URL=https://login.microsoftonline.com/87654321-4321-4321-4321-cba987654321/v2.0

# Optional: Override role mapping
# MINIPAM_OIDC_ROLE_MAPPING=my-admin-group:readwrite,my-user-group:readonly

# Optional: Enable debug mode for troubleshooting
# MINIPAM_DEBUG=true
