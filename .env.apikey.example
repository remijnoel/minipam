# Example API Key environment file for MiniPAM
# Copy this file to .env.apikey and update with your API keys

# Server Configuration
MINIPAM_PORT=8000
MINIPAM_DEBUG=false

# Storage Configuration
MINIPAM_STORAGE_TYPE=file

# Authentication Configuration - API Keys
MINIPAM_AUTH_BACKEND=apikey
ENABLE_NOAUTH=false

# API Keys (comma-separated list)
MINIPAM_AUTH_APIKEY_KEYS=your-api-key-1,your-api-key-2,your-api-key-3

# UI Configuration
MINIPAM_UI_ENABLED=true
MINIPAM_UI_PATH=/