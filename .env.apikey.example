# MiniPAM Environment Configuration - API Key Authentication
# Copy this file to .env to use API key authentication

# Configuration file to use
MINIPAM_CONFIG_FILE=/app/config.apikey.yaml

# Production JWT secret (change this!)
MINIPAM_JWT_SECRET=your-production-jwt-secret-change-this

# Production API keys (change these!)
# Format: MINIPAM_API_KEY_<USERNAME>=<api-key>:<role>
MINIPAM_API_KEY_ADMIN=sk-admin-prod-xyz123:readwrite
MINIPAM_API_KEY_VIEWER=sk-viewer-prod-abc456:readonly
MINIPAM_API_KEY_SERVICE=sk-service-prod-def789:readwrite

# Optional: Enable debug mode for troubleshooting
# MINIPAM_DEBUG=true
